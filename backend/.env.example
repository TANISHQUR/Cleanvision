# Copy to backend/.env and change the secrets.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=cleanvision
# Set to 1 to run without MongoDB (in-memory, data is lost on restart)
USE_MOCK_DB=0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SECRET_KEY=replace-with-a-long-random-string
# Must match api.token in config.yaml if you run the detector by hand
DETECTOR_TOKEN=change-me-detector-token

CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=500

# Demo fine amounts in INR
FINE_DEFAULT=500
FINE_AMOUNTS={"bottle": 500, "can": 500, "wrapper": 300, "paper": 200, "cup": 300}
